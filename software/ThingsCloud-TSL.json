      "descr": "MQ-2 已启用、已采样且未超量程。",
      "attributeType": "report",
      "dataType": "boolean",
      "options": {
        "valueType": "boolean"
      }
    },
    {
      "identifier": "mq135_mv",
      "name": "MQ-135 输出电压",
      "descr": "由 ADC 和板上分压比换算的 MQ-135 AO 电压。",
      "attributeType": "report",
      "dataType": "number",
      "options": {
        "unit": "mV",
        "min": "0",
        "max": "5100"
      }
