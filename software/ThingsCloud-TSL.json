{
  "name": "ESP32 手柄 R9",
  "descr": "ESP32-S3 手柄与执行板。DHT11、MQ-2、MQ-135 采样，TB6612 双路电机和 MG996R 控制。",
  "icon": "mdi-cube-outline",
  "attributes": [
    {
      "identifier": "motor_a_pct",
      "name": "电机 A 调速",
