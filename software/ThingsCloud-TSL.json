      "dataType": "number",
      "options": {
        "unit": "℃",
        "min": "0",
        "max": "50"
      }
    },
    {
      "identifier": "humidity",
      "name": "相对湿度",
      "descr": "DHT11 相对湿度。",
      "attributeType": "report",
      "dataType": "number",
      "options": {
        "unit": "%",
        "min": "0",
        "max": "100"
      }
    },
    {
      "identifier": "dht_valid",
